# ====================================================================
# GeneXus Access Manager (GAM 18) - Configuración de Variables de Entorno
# ====================================================================

# 1. URL pública del Identity Provider (IDP) de GAM donde el usuario se autentica
# Puede ser tu servidor local o tu dominio de producción.
VITE_GAM_PUBLIC_URL="http://<servidor:puerto>/<directorio_virtual>"

# 2. URL base para peticiones REST desde el frontend (usa el proxy de Vite en dev para evitar CORS)
VITE_GAM_BASE_URL="/api-gam/<directorio_virtual>"

# 3. Client ID registrado en la aplicación GAM
VITE_GAM_CLIENT_ID="tu_client_id_en_gam"

# 4. Client Secret (SOLO para backend confidencial en Node.js; NUNCA exponer en frontend)
GAM_CLIENT_SECRET="tu_client_secret_aqui"

# 5. URI de redirección tras el login en GAM
VITE_GAM_REDIRECT_URI="http://localhost:3000/oauth/gam/callback"

# 6. Scopes solicitados a GAM
VITE_GAM_SCOPE="gam_user_data+gam_user_roles"

# ====================================================================
# Configuración del Entorno de Desarrollo (Vite / AI Studio)
# ====================================================================
APP_URL="http://localhost:3000"
