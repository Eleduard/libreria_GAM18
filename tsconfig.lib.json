{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src/lib",
    "outDir": "./dist-lib/types",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/lib/**/*"]
}
